# ======================
# General
# ======================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=3000
HOST=0.0.0.0

# ======================
# Database
# ======================
DATABASE_URL=postgresql://postgres:password@localhost:5432/cryptra
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ======================
# Authentication
# ======================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# ======================
# Wallet & Blockchain
# ======================
WALLETCONNECT_PROJECT_ID=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TON_API_KEY=

# ======================
# Market Data
# ======================
COINGECKO_API_KEY=
BIRDEYE_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ======================
# Trading Protocols
# ======================
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
ONEINCH_API_KEY=

# ======================
# Telegram (@Cryptrabot)
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=Cryptrabot
TELEGRAM_MINI_APP_URL=https://your-mini-app-url.com
# Your personal/group chat id for error alerts (get from @userinfobot)
ADMIN_TELEGRAM_CHAT_ID=

# ======================
# Fees / Rate limit
# ======================
BASE_FEE_PERCENT=0.088
MIN_FEE_PERCENT=0.033
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ======================
# Monitoring
# ======================
LOG_LEVEL=info
ENABLE_METRICS=true
SENTRY_DSN=

# ======================
# Admin
# ======================
ADMIN_API_KEY=your-admin-api-key
