# ======================
# General
# ======================
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
# Production (cryptraa.ir):
CORS_ALLOWED_ORIGINS=https://cryptraa.ir,https://www.cryptraa.ir

# ======================
# Database
# ======================
DATABASE_URL=postgresql://cryptra:cryptra@localhost:5432/cryptra
REDIS_URL=redis://localhost:6379
POSTGRES_USER=cryptra
POSTGRES_PASSWORD=cryptra
POSTGRES_DB=cryptra

# ======================
# Authentication
# ======================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# ======================
# Telegram
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=Cryptrabot
TELEGRAM_MINI_APP_URL=https://cryptraa.ir
ADMIN_TELEGRAM_CHAT_ID=

# ======================
# Wallet & Blockchain
# ======================
WALLETCONNECT_PROJECT_ID=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
TON_API_KEY=

# ======================
# Market / DEX
# ======================
COINGECKO_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6
ONEINCH_API_KEY=
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# Optional: agent wallet for live HL exchange orders (NEVER commit real key)
# Without this key, orders track HL mid only (safe default).
HYPERLIQUID_AGENT_PRIVATE_KEY=
# Prefer testnet until verified:
# HYPERLIQUID_API_URL=https://api.hyperliquid-testnet.xyz

# ======================
# Fees / Rate limit
# ======================
BASE_FEE_PERCENT=0.088
MIN_FEE_PERCENT=0.033
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ======================
# Monitoring / Admin
# ======================
LOG_LEVEL=info
ENABLE_METRICS=true
ADMIN_API_KEY=your-admin-api-key
HEALTH_WATCHDOG_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=60000
