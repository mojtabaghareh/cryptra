# ======================
# General
# ======================
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
# Empty = allow all origins in code path that splits this (dev)
CORS_ALLOWED_ORIGINS=

# ======================
# Database (matches docker-compose.yml)
# ======================
DATABASE_URL=postgresql://cryptra:cryptra@localhost:5432/cryptra
REDIS_URL=redis://localhost:6379

# ======================
# Authentication
# ======================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# ======================
# Telegram (@Cryptrabot)
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=Cryptrabot
# MUST be https:// for Telegram WebApp
TELEGRAM_MINI_APP_URL=https://your-tunnel-or-domain.com
ADMIN_TELEGRAM_CHAT_ID=

# Mini App (Vite) — leave empty to use same-origin /api proxy in dev
# VITE_API_URL=

# ======================
# Wallet & Blockchain
# ======================
WALLETCONNECT_PROJECT_ID=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TON_API_KEY=

# ======================
# Market / DEX
# ======================
COINGECKO_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6
ONEINCH_API_KEY=
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# ======================
# Fees / Rate limit
# ======================
BASE_FEE_PERCENT=0.088
MIN_FEE_PERCENT=0.033
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ======================
# Monitoring / Admin
# ======================
LOG_LEVEL=info
ENABLE_METRICS=true
ADMIN_API_KEY=your-admin-api-key
