# ======================
# General
# ======================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ======================
# Database
# ======================
DATABASE_URL=postgresql://postgres:password@localhost:5432/cryptra
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ======================
# Authentication
# ======================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ======================
# Wallet & Blockchain
# ======================
# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Ethereum / EVM
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key
NEXT_PUBLIC_INFURA_API_KEY=your_infura_key

# Solana
NEXT_PUBLIC_HELIUS_API_KEY=your_helius_key
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# TON
NEXT_PUBLIC_TON_API_KEY=your_ton_api_key
NEXT_PUBLIC_TONCENTER_API_KEY=your_toncenter_key

# ======================
# Market Data
# ======================
COINGECKO_API_KEY=
BIRDEYE_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ======================
# Trading Protocols
# ======================
# Hyperliquid
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# 1inch
ONEINCH_API_KEY=

# ======================
# Telegram
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_MINI_APP_URL=https://your-mini-app-url.com

# ======================
# Admin
# ======================
ADMIN_API_KEY=your-admin-api-key
