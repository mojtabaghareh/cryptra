{
  "name": "@cryptra/service-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cryptra Backend API — Fastify HTTP server exposing the versioned REST API (/api/v1)",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
