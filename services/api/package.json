    "@cryptra/database": "workspace:*",
    "@cryptra/auth": "workspace:*",
    "@cryptra/security": "workspace:*",
    "@cryptra/wallets": "workspace:*",
    "@cryptra/market-data": "workspace:*",
    "@cryptra/swap-engine": "workspace:*",
    "@cryptra/xp": "workspace:*",
    "@cryptra/levels": "workspace:*",
    "@cryptra/referral": "workspace:*",
    "@cryptra/portfolio": "workspace:*",
    "@cryptra/reflection": "workspace:*",
    "@cryptra/leaderboard": "workspace:*",
    "@cryptra/admin": "workspace:*",
    "@cryptra/achievements": "workspace:*",
    "@cryptra/notifications": "workspace:*",
    "@cryptra/monitoring": "workspace:*",
    "@cryptra/service-users": "workspace:*",
    "@cryptra/service-wallets": "workspace:*",
    "fastify": "^4.28.1",
