    "@fastify/helmet": "^11.1.1",
    "zod": "^3.23.8",
    "ethers": "^6.13.4",
    "tweetnacl": "^1.0.3",
    "bs58": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
