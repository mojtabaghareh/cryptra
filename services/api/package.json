  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.1",
    "rimraf": "^6.0.1",
    "@types/node": "^22.7.4",
    "@types/jsonwebtoken": "^9.0.7"
  },
  "engines": {
    "node": ">=18.18.0"
