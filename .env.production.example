# Copy on server:  cp .env.production.example .env
# NEVER commit real .env with secrets

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

APP_URL=https://cryptraa.ir
API_URL=https://cryptraa.ir
CORS_ALLOWED_ORIGINS=https://cryptraa.ir,https://www.cryptraa.ir

# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHARS
JWT_EXPIRES_IN=7d

TELEGRAM_BOT_TOKEN=REPLACE_BOT_TOKEN
TELEGRAM_BOT_USERNAME=Cryptrabot
TELEGRAM_MINI_APP_URL=https://cryptraa.ir
ADMIN_TELEGRAM_CHAT_ID=83355128
ADMIN_API_KEY=REPLACE_ADMIN_KEY

POSTGRES_USER=cryptra
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_DB=cryptra
DATABASE_URL=postgresql://cryptra:REPLACE_DB_PASSWORD@postgres:5432/cryptra
REDIS_URL=redis://redis:6379

LOG_LEVEL=info
ENABLE_METRICS=true
HEALTH_WATCHDOG_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=60000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BASE_FEE_PERCENT=0.088
MIN_FEE_PERCENT=0.033

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Optional
# ONEINCH_API_KEY=
# VITE_API_URL=
