{
  "name": "cryptra",
  "version": "0.1.0",
  "private": true,
  "description": "Cryptra monorepo — Telegram Mini App + Bot + API",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @cryptra/database db:generate",
    "db:push": "pnpm --filter @cryptra/database db:push",
    "db:seed": "pnpm --filter @cryptra/database db:seed",
    "dev:api": "pnpm --filter @cryptra/service-api dev",
    "dev:bot": "pnpm --filter @cryptra/telegram-bot dev",
    "dev:workers": "pnpm --filter @cryptra/workers dev",
    "dev:miniapp": "pnpm --filter @cryptra/telegram-mini-app dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  }
}
