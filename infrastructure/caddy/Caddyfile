# Cryptra reverse proxy with automatic HTTPS (Let's Encrypt)
#
# Usage with docker-compose.caddy.yml:
#   export DOMAIN=app.yourdomain.com
#   export EMAIL=you@yourdomain.com
#   docker compose -f docker-compose.prod.yml -f docker-compose.caddy.yml up -d
#
# For local HTTP-only testing without real domain, use :80 block below.

{
	email {$EMAIL:admin@localhost}
}

{$DOMAIN:localhost} {
	encode gzip

	# Mini App (static + SPA)
	handle {
		reverse_proxy miniapp:80
	}

	# Explicit API path (nginx inside miniapp also proxies /api — either works)
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle /health {
		reverse_proxy api:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
