# Cryptra production — cryptraa.ir
# DNS A @ → 5.75.205.142 (Hetzner)
#
# Override if needed:
#   DOMAIN=cryptraa.ir EMAIL=you@mail.com docker compose -f docker-compose.prod.yml -f docker-compose.caddy.yml up -d

{
	email {$EMAIL:admin@cryptraa.ir}
}

cryptraa.ir, www.cryptraa.ir {
	encode gzip

	# API + health on the same host (Telegram Mini App same-origin)
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}
	handle /ready {
		reverse_proxy api:3000
	}
	handle /metrics {
		reverse_proxy api:3000
	}

	# Mini App SPA
	handle {
		reverse_proxy miniapp:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
