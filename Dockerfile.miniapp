# Cryptra Mini App — static build + nginx
FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/telegram-mini-app ./apps/telegram-mini-app
WORKDIR /app/apps/telegram-mini-app
RUN pnpm install --no-frozen-lockfile
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm build

FROM nginx:1.27-alpine
COPY infrastructure/nginx/miniapp.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/telegram-mini-app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK CMD wget -qO- http://127.0.0.1/ || exit 1
