# Cryptra Mini App — static nginx
FROM node:20-alpine AS build
RUN apk add --no-cache libc6-compat python3 make g++ \
  && corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/telegram-mini-app ./apps/telegram-mini-app
RUN mkdir -p apps/telegram-bot services \
  && echo '{"name":"@cryptra/telegram-bot","private":true}' > apps/telegram-bot/package.json \
  && echo '{"name":"@cryptra/service-api","private":true}' > services/api/package.json

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm install --no-frozen-lockfile \
  && pnpm --filter @cryptra/telegram-mini-app build

FROM nginx:1.27-alpine
COPY infrastructure/nginx/miniapp.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/telegram-mini-app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
