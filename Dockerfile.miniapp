# Cryptra Mini App — standalone Vite build + nginx
# Avoids monorepo/pnpm issues on small VPS builds
FROM node:20-alpine AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=2048

COPY apps/telegram-mini-app/package.json apps/telegram-mini-app/package-lock.json* ./
RUN npm install --legacy-peer-deps

COPY apps/telegram-mini-app/ ./

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN npx vite build

FROM nginx:1.27-alpine
COPY infrastructure/nginx/miniapp.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
