{
  "name": "@cryptra/monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "Observability: metrics, health, structured logging helpers, Telegram alerts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@cryptra/config": "workspace:*",
    "@cryptra/notifications": "workspace:*",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsup": "^8.3.5",
    "rimraf": "^6.0.1",
    "@types/node": "^22.10.0"
  }
}
