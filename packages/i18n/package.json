{
  "name": "@cryptra/i18n",
  "version": "2.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --external react,react-dom,i18next,react-i18next,i18next-browser-languagedetector",
    "dev": "tsup index.ts --format cjs,esm --dts --watch --external react,react-dom,i18next,react-i18next,i18next-browser-languagedetector",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "i18next": "^23.11.0",
    "react-i18next": "^14.1.0",
    "i18next-browser-languagedetector": "^7.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0"
  }
}
