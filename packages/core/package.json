{
  "name": "@cryptra/core",
  "version": "0.1.0",
  "private": true,
  "description": "Cryptra Core Domain — shared Types, Constants, Errors and Validators",
  "license": "UNLICENSED",
  "main": "./index.ts",
  "types": "./index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "@solana/web3.js": "^1.95.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsup": "^8.3.5",
    "vitest": "^2.1.0",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
