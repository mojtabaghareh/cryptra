    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsup": "^8.3.5",
    "rimraf": "^6.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0"
  }
